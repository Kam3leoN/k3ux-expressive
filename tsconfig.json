{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "paths": {
      "@k3ux/*": ["./src/*"],
      "k3ui": ["./types/k3ui-peer.d.ts"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "tests/unit", "types", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules", "tests/k3ui-shim.ts", "playground"]
}
